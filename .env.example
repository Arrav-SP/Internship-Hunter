# Copy to .env.local (git-ignored) and fill in.
# Local values come from `npx supabase status` after `npx supabase start`.

# Supabase API URL (local default shown).
SUPABASE_URL=http://127.0.0.1:54421
# Publishable key (sb_publishable_...). Used server-side for sign-in; it can only do what the signed-in user can.
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Secret key (sb_secret_...). Server-only: bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=your-secret-key
